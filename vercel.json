{
  "version": 2,
  "builds": [
    { "src": "api/chat.js",              "use": "@vercel/node" },
    { "src": "api/sheets.js",            "use": "@vercel/node" },
    { "src": "api/config.js",            "use": "@vercel/node" },
    { "src": "api/reporte.js",           "use": "@vercel/node" },
    { "src": "api/estudiantes.js",       "use": "@vercel/node" },
    { "src": "api/evaluaciones.js",      "use": "@vercel/node" },
    { "src": "api/cafeteria.js",         "use": "@vercel/node" },
    { "src": "api/beca.js",              "use": "@vercel/node" },
    { "src": "api/cultura.js",           "use": "@vercel/node" },
    { "src": "api/staff-info.js",        "use": "@vercel/node" },
    { "src": "api/salud.js",             "use": "@vercel/node" },
    { "src": "api/asistencia.js",        "use": "@vercel/node" },
    { "src": "api/conversaciones.js",     "use": "@vercel/node" },
    { "src": "api/psicopedagogico.js",   "use": "@vercel/node" },
    { "src": "*.html",                   "use": "@vercel/static" }
  ],
  "crons": [
    { "path": "/api/reporte",                    "schedule": "0 13 * * 1" },
    { "path": "/api/cafeteria?accion=reporte",   "schedule": "0 13 * * 1" },
    { "path": "/api/cultura?accion=healthcheck", "schedule": "0 14 1 * *" }
  ],
  "routes": [
    { "src": "/api/chat",               "dest": "/api/chat.js"               },
    { "src": "/api/sheets",             "dest": "/api/sheets.js"             },
    { "src": "/api/config",             "dest": "/api/config.js"             },
    { "src": "/api/reporte",            "dest": "/api/reporte.js"            },
    { "src": "/api/estudiantes",        "dest": "/api/estudiantes.js"        },
    { "src": "/api/evaluacion",         "dest": "/api/evaluaciones.js"       },
    { "src": "/api/evaluaciones",       "dest": "/api/evaluaciones.js"       },
    { "src": "/api/cafeteria",          "dest": "/api/cafeteria.js"          },
    { "src": "/api/beca",               "dest": "/api/beca.js"               },
    { "src": "/api/cultura",            "dest": "/api/cultura.js"            },
    { "src": "/r/(.*)",                 "dest": "/api/cultura.js?accion=visitar&slug=$1" },
    { "src": "/bot",                    "dest": "/bot.html"                  },
    { "src": "/config",                 "dest": "/config.html"               },
    { "src": "/qr",                     "dest": "/qr.html"                   },
    { "src": "/eval",                   "dest": "/eval.html"                 },
    { "src": "/cafeteria",              "dest": "/cafeteria.html"            },
    { "src": "/cafeteria-dashboard",    "dest": "/cafeteria-dashboard.html"  },
    { "src": "/ejecutivo",              "dest": "/ejecutivo.html"            },
    { "src": "/login",                  "dest": "/login.html"                },
    { "src": "/recreativos-dashboard",  "dest": "/index.html"                },
    { "src": "/api/staff-info",         "dest": "/api/staff-info.js"         },
    { "src": "/api/salud",              "dest": "/api/salud.js"              },
    { "src": "/api/asistencia",         "dest": "/api/asistencia.js"         },
    { "src": "/api/conversaciones",    "dest": "/api/conversaciones.js"     },
    { "src": "/charla",                 "dest": "/charla.html"               },
    { "src": "/salud-dashboard",        "dest": "/salud-dashboard.html"      },
    { "src": "/atencion-eval",          "dest": "/atencion-eval.html"        },
    { "src": "/asistencia-dashboard",   "dest": "/asistencia-dashboard.html" },
    { "src": "/beca",                   "dest": "/beca.html"                 },
    { "src": "/beca-dashboard",         "dest": "/beca-dashboard.html"       },
    { "src": "/cultura-dashboard",      "dest": "/cultura-dashboard.html"    },
    { "src": "/cultura",                    "dest": "/cultura.html"                    },
    { "src": "/api/psicopedagogico",        "dest": "/api/psicopedagogico.js"          },
    { "src": "/psicopedagogico-dashboard",  "dest": "/psicopedagogico-dashboard.html"  },
    { "src": "/psico-atencion-eval",        "dest": "/psico-atencion-eval.html"        },
    { "src": "/psico-charla-eval",          "dest": "/psico-charla-eval.html"          },
    { "src": "/bot.html",                   "dest": "/bot.html"                        },
    { "src": "/",                       "dest": "/login.html"                },
    { "src": "/(.*)",                   "dest": "/index.html"                }
  ]
}
