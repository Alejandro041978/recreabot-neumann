{
  "version": 2,
  "builds": [
    { "src": "api/chat.js",   "use": "@vercel/node" },
    { "src": "api/sheets.js", "use": "@vercel/node" },
    { "src": "api/config.js", "use": "@vercel/node" },
    { "src": "*.html",        "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/chat",   "dest": "/api/chat.js"   },
    { "src": "/api/sheets", "dest": "/api/sheets.js" },
    { "src": "/api/config", "dest": "/api/config.js" },
    { "src": "/bot",        "dest": "/bot.html"      },
    { "src": "/config",     "dest": "/config.html"   },
    { "src": "/bot.html",   "dest": "/bot.html"      },
    { "src": "/(.*)",       "dest": "/index.html"    }
  ]
}
